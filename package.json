{
  "name": "@xia-sc/dsh-workspace-integrity",
  "version": "0.4.1",
  "description": "在 Windows 上修复 DSH workspace-write 沙箱遗留在工作区上的 Low 完整性标签，附带完整性面板、agent 工具、回滚记录与自动清理。",
  "license": "MIT",
  "author": "xia-sc",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "routes.js",
    "cordis.patch.yml",
    "scripts",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "windows",
    "integrity",
    "acl",
    "sandbox"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xia-sc/dsh-workspace-integrity.git"
  },
  "homepage": "https://github.com/xia-sc/dsh-workspace-integrity#readme",
  "bugs": {
    "url": "https://github.com/xia-sc/dsh-workspace-integrity/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
